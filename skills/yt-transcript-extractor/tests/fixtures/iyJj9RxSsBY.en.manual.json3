  }, {
    "tStartMs": 711307,
    "dDurationMs": 1493,
    "segs": [ {
      "utf8": "or things like that."
    } ]
  }, {
    "tStartMs": 712800,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "But it wouldn't be baked into\nthe model in the same way."
    } ]
  }, {
    "tStartMs": 716100,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "If you refresh the model,\nit wouldn't then still have"
    } ]
  }, {
    "tStartMs": 721020,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "the personality of Margaret Thatcher."
    } ]
  }, {
    "tStartMs": 722760,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "So that's almost a play acting thing,"
    } ]
  }, {
    "tStartMs": 724320,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "but how does that differ from"
