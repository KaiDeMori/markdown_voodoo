      "utf8": "I mean there's, like, a\nhuge amount of overlap."
    } ]
  }, {
    "tStartMs": 880650,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "But I guess I think of character maybe"
    } ]
  }, {
    "tStartMs": 882780,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "in the sort of, like, virtue\nethical sense or something."
    } ]
  }, {
    "tStartMs": 886410,
    "dDurationMs": 1651,
    "segs": [ {
      "utf8": "- Oh, now we're getting very-\n- I know, I know."
    } ]
  }, {
    "tStartMs": 888061,
    "dDurationMs": 1979,
    "segs": [ {
      "utf8": "- [Stuart] Very philosophical."
    } ]
  }, {
    "tStartMs": 890040,
    "dDurationMs": 974,
    "segs": [ {
      "utf8": "Yeah, carry on, carry on."
    } ]
  }, {
    "tStartMs": 891014,
    "dDurationMs": 1846,
    "segs": [ {
      "utf8": "- [Amanda] I know, it turns\nout Aristotle, you know,"
    } ]
  }, {
    "tStartMs": 892860,
    "dDurationMs": 1281,
    "segs": [ {
      "utf8": "it turns out it was useful after all,"
    } ]
  }, {
    "tStartMs": 894141,
    "dDurationMs": 1929,
    "segs": [ {
      "utf8": "- [Stuart] After thousands of years,"
    } ]
  }, {
    "tStartMs": 896070,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "has suddenly become useful."
    } ]
  }, {
    "tStartMs": 896910,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "Yeah, all right, carry on."
    } ]
  }, {
    "tStartMs": 898200,
    "dDurationMs": 1314,
    "segs": [ {
      "utf8": "- [Amanda] I was useful the whole time!"
    } ]
  }, {
    "tStartMs": 899514,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "It just didn't, you know. (laughs)"
