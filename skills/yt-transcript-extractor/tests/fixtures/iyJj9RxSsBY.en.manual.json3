  "events": [ {
    "tStartMs": 240,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "- [Stuart] Hello, I'm\nStuart from Anthropic."
    } ]
  }, {
    "tStartMs": 3210,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Now, we publish a lot of research papers"
    } ]
  }, {
    "tStartMs": 5340,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "and research updates,"
    } ]
  }, {
    "tStartMs": 6930,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "but we thought it might\nalso be interesting"
    } ]
  }, {
    "tStartMs": 8760,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "to publish some conversations\nwith our AI researchers,"
    } ]
  }, {
    "tStartMs": 12270,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "where they talk a bit about\nwhat they've been working on"
    } ]
  }, {
    "tStartMs": 15150,
    "dDurationMs": 2948,
    "segs": [ {
      "utf8": "and maybe share some insights\nthat wouldn't necessarily"
    } ]
  }, {
    "tStartMs": 18098,
    "dDurationMs": 2755,
    "segs": [ {
      "utf8": "make it into a formal scientific paper."
    } ]
  }, {
    "tStartMs": 21780,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Now, this is one of those conversations."
    } ]
  }, {
    "tStartMs": 23490,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "And it's about Claude's character,"
    } ]
  }, {
    "tStartMs": 25410,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "that is, the personality\nof our AI model, Claude."
    } ]
  }, {
    "tStartMs": 30120,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "You might think that's\na bit of a strange thing"
    } ]
  }, {
    "tStartMs": 32310,
    "dDurationMs": 1453,
    "segs": [ {
      "utf8": "to talk about."
    } ]
  }, {
    "tStartMs": 33763,
    "dDurationMs": 3083,
    "segs": [ {
      "utf8": "How can an AI model have a personality?"
    } ]
  }, {
    "tStartMs": 36846,
    "dDurationMs": 2274,
    "segs": [ {
      "utf8": "But it turns out this\nis actually something"
    } ]
  }, {
    "tStartMs": 39120,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "we've thought about really quite deeply,"
    } ]
  }, {
    "tStartMs": 41580,
    "dDurationMs": 1476,
    "segs": [ {
      "utf8": "and it raises all kinds of interesting"
    } ]
  }, {
    "tStartMs": 43056,
    "dDurationMs": 2458,
    "segs": [ {
      "utf8": "philosophical questions."
    } ]
  }, {
    "tStartMs": 45514,
    "dDurationMs": 2516,
    "segs": [ {
      "utf8": "That makes it particularly\napt that I'm joined"
    } ]
  }, {
    "tStartMs": 48030,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "for the conversation\ntoday by Amanda Askell,"
    } ]
  }, {
    "tStartMs": 51120,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "who is a trained philosopher"
    } ]
  }, {
    "tStartMs": 52650,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "and works on our alignment\nfine tuning team at Anthropic."
    } ]
  }, {
    "tStartMs": 57600,
    "dDurationMs": 3543,
    "segs": [ {
      "utf8": "So hope you enjoy the\nconversation with Amanda Askell."
    } ]
  }, {
    "tStartMs": 62430,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Amanda, is it weird that\nyou are a philosopher,"
    } ]
  }, {
    "tStartMs": 65790,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "given that philosophers\naren't normally the ones"
    } ]
  }, {
    "tStartMs": 67650,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "that are training AI models?"
    } ]
  }, {
    "tStartMs": 70060,
    "dDurationMs": 1047,
    "segs": [ {
      "utf8": "- [Amanda] Yeah, I guess, like, sometimes,"
    } ]
  }, {
    "tStartMs": 71107,
    "dDurationMs": 1553,
    "segs": [ {
      "utf8": "you know, some of my work"
    } ]
  }, {
    "tStartMs": 72660,
    "dDurationMs": 2097,
    "segs": [ {
      "utf8": "philosophy's, like,\nmaybe less relevant to."
    } ]
  }, {
    "tStartMs": 74757,
    "dDurationMs": 1953,
    "segs": [ {
      "utf8": "And this is actually a kind of topic,"
    } ]
  }, {
    "tStartMs": 76710,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "you know, the Claude character work"
    } ]
  }, {
    "tStartMs": 78300,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "feels like much more kind of,\nlike, philosophically rich."
    } ]
  }, {
    "tStartMs": 80700,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "And it's actually kind of-\n- Yeah, yeah, totally."
    } ]
  }, {
    "tStartMs": 81990,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "- [Amanda] Yeah, like\nuseful to be a philosopher"
    } ]
  }, {
    "tStartMs": 83430,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "or something here."
    } ]
  }, {
    "tStartMs": 84263,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "- [Stuart] (laughs) Why, sure."
    } ]
  }, {
    "tStartMs": 86433,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Amanda] Yeah."
    } ]
  }, {
    "tStartMs": 87266,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Stuart] That's what I thought."
    } ]
  }, {
    "tStartMs": 88099,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Sorry, I don't mean to be insulting."
    } ]
  }, {
    "tStartMs": 88932,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Amanda] No, it's fine."
    } ]
  }, {
    "tStartMs": 89765,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Like, lots of people are like,"
    } ]
  }, {
    "tStartMs": 90598,
    "dDurationMs": 1378,
    "segs": [ {
      "utf8": "\"See, I told you the\ndegree would be useful.\""
    } ]
  }, {
    "tStartMs": 91976,
    "dDurationMs": 1294,
    "segs": [ {
      "utf8": "- [Stuart] Right, yeah, exactly."
    } ]
  }, {
    "tStartMs": 93270,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "You've found, weirdly enough-\n- I found a niche, yeah."
    } ]
  }, {
    "tStartMs": 94310,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "- [Stuart] You found a field"
    } ]
  }, {
    "tStartMs": 95610,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "where this is actually useful."
    } ]
  }, {
    "tStartMs": 96660,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "- [Amanda] Trying to make AI, you know,"
    } ]
  }, {
    "tStartMs": 98228,
    "dDurationMs": 3082,
    "segs": [ {
      "utf8": "be good in the virtue\nethical sense of the word."
    } ]
  }, {
    "tStartMs": 101310,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "- [Stuart] So it might be\na philosophical question,"
    } ]
  }, {
    "tStartMs": 104070,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "but is it an alignment question"
    } ]
  }, {
    "tStartMs": 105870,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "to think about Claude's personality?"
    } ]
  }, {
    "tStartMs": 109290,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- [Amanda] Yeah, so I guess I think about"
    } ]
  }, {
    "tStartMs": 111030,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "rather than just\npersonality, like, character"
    } ]
  }, {
    "tStartMs": 113010,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "in this, like, kind of broader sense."
    } ]
  }, {
    "tStartMs": 115110,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "And to my mind, you know,\nso alignment is about, like,"
    } ]
  }, {
    "tStartMs": 118560,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "making sure that AI models are, like,"
    } ]
  }, {
    "tStartMs": 120420,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "aligned with human values"
    } ]
  }, {
    "tStartMs": 122160,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and trying to do so in a way that scales"
    } ]
  }, {
    "tStartMs": 123660,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "as the models get more capable."
    } ]
  }, {
    "tStartMs": 125460,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "And in some ways, I do think\nthat character feels, like,"
    } ]
  }, {
    "tStartMs": 128910,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "in fact is very important to that,"
    } ]
  }, {
    "tStartMs": 130710,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "because in many ways, character\nis, like, our dispositions"
    } ]
  }, {
    "tStartMs": 133830,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "and, like, how we are\ngoing to act in the world,"
    } ]
  }, {
    "tStartMs": 135570,
    "dDurationMs": 1321,
    "segs": [ {
      "utf8": "how we're going to interact with people"
    } ]
  }, {
    "tStartMs": 136891,
    "dDurationMs": 2248,
    "segs": [ {
      "utf8": "and what it is to be like, you know,"
    } ]
  }, {
    "tStartMs": 139139,
    "dDurationMs": 2101,
    "segs": [ {
      "utf8": "aligned with people's values"
    } ]
  }, {
    "tStartMs": 141240,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and to, like, deal well with the fact that"
    } ]
  }, {
    "tStartMs": 143700,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "people have many\ndifferent kinds of values."
    } ]
  }, {
    "tStartMs": 145590,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Like, that is a question\nof, like, of character"
    } ]
  }, {
    "tStartMs": 147900,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and, like, having a good character"
    } ]
  }, {
    "tStartMs": 149670,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "that responds well to people,\nand having good dispositions,"
    } ]
  }, {
    "tStartMs": 152370,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and having a disposition towards, like,"
    } ]
  }, {
    "tStartMs": 154290,
    "dDurationMs": 1812,
    "segs": [ {
      "utf8": "liking people, being kind to them."
    } ]
  }, {
    "tStartMs": 156102,
    "dDurationMs": 2898,
    "segs": [ {
      "utf8": "And so to my mind, this is like,"
    } ]
  }, {
    "tStartMs": 159000,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "it's not something like, ah\nthis is a solution to, like,"
    } ]
  }, {
    "tStartMs": 161610,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "all future problems of\nalignment, but in many ways,"
    } ]
  }, {
    "tStartMs": 164490,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "like, alignment is just like,"
    } ]
  }, {
    "tStartMs": 165960,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "does the model have a good character"
    } ]
  }, {
    "tStartMs": 167520,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and act well towards us and towards, like,"
    } ]
  }, {
    "tStartMs": 170220,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "you know, everything else"
    } ]
  }, {
    "tStartMs": 171300,
    "dDurationMs": 1964,
    "segs": [ {
      "utf8": "and trying to find a\nway to make that scale."
    } ]
  }, {
    "tStartMs": 173264,
    "dDurationMs": 1456,
    "segs": [ {
      "utf8": "- [Stuart] So you can boil alignment down."
    } ]
  }, {
    "tStartMs": 174720,
    "dDurationMs": 2917,
    "segs": [ {
      "utf8": "You can boil alignment down to being about"
    } ]
  }, {
    "tStartMs": 177637,
    "dDurationMs": 1496,
    "segs": [ {
      "utf8": "the character of an AI model."
    } ]
  }, {
    "tStartMs": 180030,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "- [Amanda] Yeah, there's a\ncertain sense in which, like,"
    } ]
  }, {
    "tStartMs": 181440,
    "dDurationMs": 1994,
    "segs": [ {
      "utf8": "yeah, it's like a naive, you know,"
    } ]
  }, {
    "tStartMs": 183434,
    "dDurationMs": 856,
    "segs": [ {
      "utf8": "so sometimes people\nmight think this is like,"
    } ]
  }, {
    "tStartMs": 184290,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "and in some ways it is, like, naive,"
    } ]
  }, {
    "tStartMs": 185760,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "which is just the, like, teach the models,"
    } ]
  }, {
    "tStartMs": 188220,
    "dDurationMs": 2462,
    "segs": [ {
      "utf8": "like, what we think, like, is good."
    } ]
  }, {
    "tStartMs": 190682,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "Like, you know what it is to\nbe a good person in the world."
    } ]
  }, {
    "tStartMs": 193516,
    "dDurationMs": 2474,
    "segs": [ {
      "utf8": "- [Stuart] People with good characters"
    } ]
  }, {
    "tStartMs": 195990,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "tend not to do bad things."
    } ]
  }, {
    "tStartMs": 197340,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "And so maybe we want to\ngive our AI a good character"
    } ]
  }, {
    "tStartMs": 199650,
    "dDurationMs": 1076,
    "segs": [ {
      "utf8": "so it doesn't do bad things, right?"
    } ]
  }, {
    "tStartMs": 200726,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Amanda] Yeah."
    } ]
  }, {
    "tStartMs": 201559,
    "dDurationMs": 881,
    "segs": [ {
      "utf8": "You might not think it solves everything,"
    } ]
  }, {
    "tStartMs": 202440,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "but I'm like, that\ndoesn't mean not to do it."
    } ]
  }, {
    "tStartMs": 203910,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "It's kind of like a naive\nand obvious thing to do"
    } ]
  }, {
    "tStartMs": 205710,
    "dDurationMs": 4217,
    "segs": [ {
      "utf8": "is to try and give, like, give\ngood characters to AI models,"
    } ]
  }, {
    "tStartMs": 209927,
    "dDurationMs": 1273,
    "segs": [ {
      "utf8": "or try to, like, teach them"
    } ]
  }, {
    "tStartMs": 211200,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "what it is to be a good character,"
    } ]
  }, {
    "tStartMs": 212310,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "or to have good character."
    } ]
  }, {
    "tStartMs": 213143,
    "dDurationMs": 1087,
    "segs": [ {
      "utf8": "- [Stuart] Right, right."
    } ]
  }, {
    "tStartMs": 214230,
    "dDurationMs": 2303,
    "segs": [ {
      "utf8": "Can we just talk for a little while about,"
    } ]
  }, {
    "tStartMs": 217434,
    "dDurationMs": 2826,
    "segs": [ {
      "utf8": "you give our audience\na little bit of context"
    } ]
  }, {
    "tStartMs": 220260,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "of how the models are trained in general."
    } ]
  }, {
    "tStartMs": 223620,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "So broadly, there's pre-training,"
    } ]
  }, {
    "tStartMs": 226980,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "which is where the\nmodel sees all the data,"
    } ]
  }, {
    "tStartMs": 228720,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "and then there's fine tuning,"
    } ]
  }, {
    "tStartMs": 229830,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "which which happens later\nonce the model is trained."
    } ]
  }, {
    "tStartMs": 233310,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "So can you talk a little bit about"
    } ]
  }, {
    "tStartMs": 234780,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "some of the stages of that,"
    } ]
  }, {
    "tStartMs": 235770,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "and then and the kind of where your work"
    } ]
  }, {
    "tStartMs": 237393,
    "dDurationMs": 2727,
    "segs": [ {
      "utf8": "comes into that process?"
    } ]
  }, {
    "tStartMs": 240120,
    "dDurationMs": 2351,
    "segs": [ {
      "utf8": "- [Amanda] Yeah, so most of\nmy work is in fine tuning,"
    } ]
  }, {
    "tStartMs": 242471,
    "dDurationMs": 3589,
    "segs": [ {
      "utf8": "and, like, there's different\nparts of fine tuning."
    } ]
  }, {
    "tStartMs": 246060,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "So most famously, I guess,\npeople use reinforcement learning"
    } ]
  }, {
    "tStartMs": 249390,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "from human feedback where\nyou get humans to, like,"
    } ]
  }, {
    "tStartMs": 252330,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "select which response from\nan AI model they prefer."
    } ]
  }, {
    "tStartMs": 255900,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "And then you can use the\ntrain preference models"
    } ]
  }, {
    "tStartMs": 257790,
    "dDurationMs": 2557,
    "segs": [ {
      "utf8": "and you can, like, RL against\nthose preference models."
    } ]
  }, {
    "tStartMs": 260347,
    "dDurationMs": 1943,
    "segs": [ {
      "utf8": "- [Stuart] Right, and so that's RLHF."
    } ]
  }, {
    "tStartMs": 262290,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "That's what everyone's talking about"
    } ]
  }, {
    "tStartMs": 263220,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "when they talk about RLHF."
    } ]
  }, {
    "tStartMs": 264053,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Amanda] Exactly, yeah."
    } ]
  }, {
    "tStartMs": 264886,
    "dDurationMs": 1694,
    "segs": [ {
      "utf8": "And then there's also constitutional AI,"
    } ]
  }, {
    "tStartMs": 266580,
    "dDurationMs": 3018,
    "segs": [ {
      "utf8": "which we use a lot at\nAnthropic, which, you know,"
    } ]
  }, {
    "tStartMs": 269598,
    "dDurationMs": 3402,
    "segs": [ {
      "utf8": "has a component which\nwe, I guess, call RLAIF,"
    } ]
  }, {
    "tStartMs": 273000,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "which is sort of where\nthe AI itself is, like,"
    } ]
  }, {
    "tStartMs": 275940,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "is the one that's giving the feedback."
    } ]
  }, {
    "tStartMs": 277380,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "So, you know, you can give\na series of principles,"
    } ]
  }, {
    "tStartMs": 279270,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "for example, and it gives\nthis, like, feedback"
    } ]
  }, {
    "tStartMs": 282870,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "that you use to train\nthe preference model,"
    } ]
  }, {
    "tStartMs": 284400,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "and then you can train against that."
