  }, {
    "tStartMs": 639000,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "But the other is that as a result,"
    } ]
  }, {
    "tStartMs": 640740,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "I think it is actually\njust sometimes easier"
