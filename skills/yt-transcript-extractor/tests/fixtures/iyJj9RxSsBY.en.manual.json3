  }, {
    "tStartMs": 593934,
    "dDurationMs": 3246,
    "segs": [ {
      "utf8": "But you can see, like, political\nleanings in these models,"
    } ]
  }, {
    "tStartMs": 597180,
    "dDurationMs": 2209,
    "segs": [ {
      "utf8": "and you can see, like,\nbehaviors and biases,"
    } ]
  }, {
    "tStartMs": 599389,
    "dDurationMs": 2681,
    "segs": [ {
      "utf8": "like, you know, we've\ndone work where we see"
    } ]
  }, {
    "tStartMs": 602070,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "certain kinds of, like,"
    } ]
  }, {
    "tStartMs": 602903,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "positive discrimination in the model."
    } ]
  }, {
    "tStartMs": 604223,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "- [Stuart] Right."
    } ]
  }, {
    "tStartMs": 605190,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "- [Amanda] And I think I\njust want people, you know,"
    } ]
  }, {
    "tStartMs": 607740,
    "dDurationMs": 1858,
    "segs": [ {
      "utf8": "in line with that, wanting\npeople to be aware of"
    } ]
  }, {
    "tStartMs": 609598,
    "dDurationMs": 2882,
    "segs": [ {
      "utf8": "what they're talking with,"
    } ]
  }, {
    "tStartMs": 612480,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "that they're talking with\nsomething that like, actually,"
