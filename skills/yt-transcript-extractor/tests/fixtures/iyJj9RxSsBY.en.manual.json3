  }, {
    "tStartMs": 827312,
    "dDurationMs": 3285,
    "segs": [ {
      "utf8": "is gonna be more outgoing\nin more situations"
    } ]
  }, {
    "tStartMs": 830597,
    "dDurationMs": 1453,
    "segs": [ {
      "utf8": "than someone who's introverted, right?"
    } ]
  }, {
    "tStartMs": 832050,
    "dDurationMs": 3339,
    "segs": [ {
      "utf8": "So these are, like, broad\ntendencies of personality."
    } ]
  }, {
    "tStartMs": 835389,
    "dDurationMs": 3441,
    "segs": [ {
      "utf8": "And psychologists think about personality"
    } ]
  }, {
    "tStartMs": 838830,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "in the kind of way of,"
    } ]
  }, {
    "tStartMs": 839810,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "there's like the big\nfive personality traits."
    } ]
  }, {
    "tStartMs": 842729,
    "dDurationMs": 2491,
    "segs": [ {
      "utf8": "I've mentioned extroversion,\nsee if I can remember them all."
