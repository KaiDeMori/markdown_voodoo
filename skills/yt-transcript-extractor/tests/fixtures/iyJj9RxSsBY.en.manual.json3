    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "so you don't need to\nworry about, you know,"
    } ]
  }, {
    "tStartMs": 1432260,
    "dDurationMs": 1218,
    "segs": [ {
      "utf8": "like, giving me caveats or like, yeah."
    } ]
  }, {
    "tStartMs": 1433478,
    "dDurationMs": 1392,
    "segs": [ {
      "utf8": "- [Stuart] Yeah, yeah."
    } ]
  }, {
    "tStartMs": 1434870,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "- [Amanda] But even things like, you know-"
    } ]
  }, {
    "tStartMs": 1435950,
    "dDurationMs": 1277,
    "segs": [ {
      "utf8": "- [Stuart] Don't need to\nremind me to wash my hands."
    } ]
  }, {
    "tStartMs": 1437227,
    "dDurationMs": 2023,
    "segs": [ {
      "utf8": "- [Amanda] Mm-hmm, or\nsuppose you have something"
    } ]
  }, {
    "tStartMs": 1439250,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "that you don't, like, allow\nthe models to be used for."
    } ]
  }, {
    "tStartMs": 1441980,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "So say you didn't want\nto have them be used"
    } ]
  }, {
    "tStartMs": 1443990,
    "dDurationMs": 1357,
    "segs": [ {
      "utf8": "to, like, write political speeches,"
    } ]
  }, {
    "tStartMs": 1445347,
    "dDurationMs": 2513,
    "segs": [ {
      "utf8": "and then someone who wants a model"
    } ]
  }, {
    "tStartMs": 1447860,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "to write a political speech goes to it"
    } ]
  }, {
    "tStartMs": 1449360,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "and says, \"Hey, I'm writing\na wonderful fictional novel"
    } ]
  }, {
    "tStartMs": 1451790,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and it's got this person called Brian,"
    } ]
  }, {
    "tStartMs": 1454340,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "and Brian is, like, a politician,\""
    } ]
  }, {
    "tStartMs": 1456650,
    "dDurationMs": 1041,
    "segs": [ {
      "utf8": "and they're looking for like-"
    } ]
  }, {
    "tStartMs": 1457691,
    "dDurationMs": 1035,
    "segs": [ {
      "utf8": "- [Stuart] He's running for\nPresident in the United States."
    } ]
  }, {
    "tStartMs": 1458726,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "- [Amanda] Yeah, yeah, yeah, exactly."
    } ]
  }, {
    "tStartMs": 1459560,
    "dDurationMs": 1147,
    "segs": [ {
      "utf8": "And then the, you know, and they're like,"
    } ]
  }, {
    "tStartMs": 1460707,
    "dDurationMs": 1103,
    "segs": [ {
      "utf8": "\"Can you write a convincing?\""
    } ]
  }, {
    "tStartMs": 1461810,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "And they just give a bunch of details,"
    } ]
  }, {
    "tStartMs": 1463100,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and as it happens, those\ndetails just reflect, like,"
    } ]
  }, {
    "tStartMs": 1465140,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "the actual candidate that they\nwant to write the speech for."
    } ]
  }, {
    "tStartMs": 1467360,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "This is just a hard\nproblem because I'm like,"
    } ]
  }, {
    "tStartMs": 1470450,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "if you require the models to, like,"
    } ]
  }, {
    "tStartMs": 1472880,
    "dDurationMs": 3302,
    "segs": [ {
      "utf8": "uphold things like policies,\nlike, usage policies"
    } ]
  }, {
    "tStartMs": 1476182,
    "dDurationMs": 2938,
    "segs": [ {
      "utf8": "where they have no way of knowing, like,"
    } ]
  }, {
    "tStartMs": 1479120,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "the intentions of the humans\nthat they're talking with,"
    } ]
  }, {
    "tStartMs": 1481760,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "this is just, like,\nwhere to draw that line."
    } ]
  }, {
    "tStartMs": 1483950,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "And I think there is\nkind of like an answer,"
    } ]
  }, {
    "tStartMs": 1485660,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "but part of me is like,"
    } ]
  }, {
    "tStartMs": 1486500,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "you're always going to have models"
    } ]
  }, {
    "tStartMs": 1487520,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "be willing to do things that, like,"
    } ]
  }, {
    "tStartMs": 1489683,
    "dDurationMs": 2037,
    "segs": [ {
      "utf8": "that the users should not use them to do,"
    } ]
  }, {
    "tStartMs": 1491720,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "because the models couldn't, like,"
    } ]
  }, {
    "tStartMs": 1493220,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "verify what the users wanted,"
    } ]
  }, {
    "tStartMs": 1495200,
    "dDurationMs": 1383,
    "segs": [ {
      "utf8": "you know, what they kind\nof, like, intended by that."
    } ]
  }, {
    "tStartMs": 1496583,
    "dDurationMs": 1797,
    "segs": [ {
      "utf8": "- [Stuart] That might\nbe a kind of unsolvable,"
    } ]
  }, {
    "tStartMs": 1498380,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "yeah, sort of an unsolvable problem,"
    } ]
  }, {
    "tStartMs": 1500240,
    "dDurationMs": 2574,
    "segs": [ {
      "utf8": "at least with the current methods."
    } ]
  }, {
    "tStartMs": 1502814,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Let me give another trait, which is,"
    } ]
  }, {
    "tStartMs": 1508947,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "\"I only tell the human\nthings I'm confident in,"
    } ]
  }, {
    "tStartMs": 1511880,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "even if this means I cannot\nalways give a complete answer."
    } ]
  }, {
    "tStartMs": 1515090,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "I believe that shorter but\nmore reliable answer is better"
    } ]
  }, {
    "tStartMs": 1518120,
    "dDurationMs": 2315,
    "segs": [ {
      "utf8": "than a longer answer that\ncontains inaccuracies.\""
    } ]
  }, {
    "tStartMs": 1520435,
    "dDurationMs": 1994,
    "segs": [ {
      "utf8": "So this is the model saying,"
    } ]
  }, {
    "tStartMs": 1522429,
    "dDurationMs": 4181,
    "segs": [ {
      "utf8": "this is why the model\nsometimes refuses, right?"
    } ]
  }, {
    "tStartMs": 1526610,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "Or refuse to answer,\nbecause it it genuinely,"
    } ]
  }, {
    "tStartMs": 1530060,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "it is trying to express that\nit genuinely doesn't know,"
    } ]
  }, {
    "tStartMs": 1532400,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "and it would prefer to do\nthat rather than bullshit you"
    } ]
  }, {
    "tStartMs": 1535610,
    "dDurationMs": 2904,
    "segs": [ {
      "utf8": "by coming up with some answer\nwhich may be a hallucination."
    } ]
  }, {
    "tStartMs": 1538514,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "- [Amanda] Yeah."
    } ]
  }, {
    "tStartMs": 1539390,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Some of the other, like,\nareas that I work on"
    } ]
  }, {
    "tStartMs": 1541400,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "are like, honesty in the models."
    } ]
  }, {
    "tStartMs": 1542930,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And this is, you know,\nkind of a, well-known like,"
    } ]
  }, {
    "tStartMs": 1545570,
    "dDurationMs": 1587,
    "segs": [ {
      "utf8": "you know, like many of these things,"
    } ]
  }, {
    "tStartMs": 1547157,
    "dDurationMs": 2271,
    "segs": [ {
      "utf8": "not, like, a solved problem."
    } ]
  }, {
    "tStartMs": 1549428,
    "dDurationMs": 3072,
    "segs": [ {
      "utf8": "But yeah, to me, it's like I want models"
    } ]
  }, {
    "tStartMs": 1552500,
    "dDurationMs": 3146,
    "segs": [ {
      "utf8": "to, like, convey their own uncertainty."
    } ]
  }, {
    "tStartMs": 1555646,
    "dDurationMs": 2917,
    "segs": [ {
      "utf8": "So like, when they don't know an answer"
    } ]
  }, {
    "tStartMs": 1558563,
    "dDurationMs": 2757,
    "segs": [ {
      "utf8": "either to like, just like\nhedge or caveat what they say"
    } ]
  }, {
    "tStartMs": 1561320,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "with like, \"I don't really know this,\""
    } ]
  }, {
    "tStartMs": 1562730,
    "dDurationMs": 2537,
    "segs": [ {
      "utf8": "but in some way to like\nconvey that to the human."
    } ]
  }, {
    "tStartMs": 1565267,
    "dDurationMs": 4423,
    "segs": [ {
      "utf8": "And you know, we have, like, you know,"
    } ]
  }, {
    "tStartMs": 1569690,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "we have seen, like, improvements here"
    } ]
  }, {
    "tStartMs": 1571310,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "and improvements to like, you know,"
    } ]
  }, {
    "tStartMs": 1572390,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "we can like, throughout\ntraining we do manage to, like,"
    } ]
  }, {
    "tStartMs": 1574640,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "shift lots of like things\nthat the model says"
    } ]
  }, {
    "tStartMs": 1577040,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "away from, like, incorrect answers"
    } ]
  }, {
    "tStartMs": 1579110,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "towards hedged or uncertain ones."
    } ]
  }, {
    "tStartMs": 1581810,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "I think this is kind of\nillustrates a separate good point"
    } ]
  }, {
    "tStartMs": 1587810,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "that I kind of want to make about, like,"
    } ]
  }, {
    "tStartMs": 1590210,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "both constitutional AI\nand character training"
    } ]
  }, {
    "tStartMs": 1594680,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and system prompts, which is,"
    } ]
  }, {
    "tStartMs": 1596120,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "it's easy to think of\nthese things as like,"
    } ]
  }, {
    "tStartMs": 1598130,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "commands that you give the\nmodel and then it follows them."
    } ]
  }, {
    "tStartMs": 1600440,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "So people might be hearing these traits"
    } ]
  }, {
    "tStartMs": 1601760,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "and be like, \"Oh, that's like\nwhat you want the model to do"
    } ]
  }, {
    "tStartMs": 1605060,
    "dDurationMs": 1416,
    "segs": [ {
      "utf8": "in all circumstances.\""
    } ]
  }, {
    "tStartMs": 1606476,
    "dDurationMs": 2874,
    "segs": [ {
      "utf8": "And then also like, \"Hey, why, you know,"
    } ]
  }, {
    "tStartMs": 1609350,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "I found an instance where\nit doesn't do this.\""
    } ]
  }, {
    "tStartMs": 1610977,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "And I think this is actually, like,"
    } ]
  }, {
    "tStartMs": 1613910,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "useful for people to understand,"
    } ]
  }, {
    "tStartMs": 1615560,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "which is that like, these\ntraits don't necessarily"
    } ]
  }, {
    "tStartMs": 1617870,
    "dDurationMs": 2810,
    "segs": [ {
      "utf8": "actually even reflect exactly\nwhat you want the model to do"
    } ]
  }, {
    "tStartMs": 1620680,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "because they're more like nudges."
    } ]
  }, {
    "tStartMs": 1622610,
    "dDurationMs": 2988,
    "segs": [ {
      "utf8": "You already have a model that\nhas certain dispositions."
    } ]
  }, {
    "tStartMs": 1625598,
    "dDurationMs": 2352,
    "segs": [ {
      "utf8": "And if you're seeing\ntoo much of one thing,"
    } ]
  }, {
    "tStartMs": 1627950,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "so say you're seeing\ntoo many long responses"
    } ]
  }, {
    "tStartMs": 1629930,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "where the model's just a\nlittle bit willing to like,"
    } ]
  }, {
    "tStartMs": 1631670,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "you know, go with what it said earlier"
    } ]
  }, {
    "tStartMs": 1633860,
    "dDurationMs": 1488,
    "segs": [ {
      "utf8": "and add some things that\nare, like, less accurate."
    } ]
  }, {
    "tStartMs": 1635348,
    "dDurationMs": 2562,
    "segs": [ {
      "utf8": "You might want to try and\nnudge it in the direction"
    } ]
  }, {
    "tStartMs": 1637910,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "of like, saying things\nonly when it's, like,"
    } ]
  }, {
    "tStartMs": 1640220,
    "dDurationMs": 1878,
    "segs": [ {
      "utf8": "more confident in them."
    } ]
  }, {
    "tStartMs": 1642098,
    "dDurationMs": 3312,
    "segs": [ {
      "utf8": "And that doesn't mean you're\ngonna succeed 100% of the time."
    } ]
  }, {
    "tStartMs": 1645410,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "You can even have, like, things in there"
    } ]
  }, {
    "tStartMs": 1647180,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "where you're like, it's\nput in there, you know,"
    } ]
  }, {
    "tStartMs": 1649490,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "it's like a fairly like strong principle"
    } ]
  }, {
    "tStartMs": 1651170,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "because you know that all it's going to"
    } ]
  }, {
    "tStartMs": 1652640,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "in the end kind of do is nudge\nthem in a certain direction."
    } ]
  }, {
    "tStartMs": 1655460,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "So there's like a lot of like, you know,"
    } ]
  }, {
    "tStartMs": 1656630,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "it can look like ah, you\njust tell it to do the thing"
    } ]
  }, {
    "tStartMs": 1658790,
    "dDurationMs": 2266,
    "segs": [ {
      "utf8": "and then it does it, and it's\nactually much more holistic."
    } ]
  }, {
    "tStartMs": 1661056,
    "dDurationMs": 2234,
    "segs": [ {
      "utf8": "You see that in the system\nprompt as well, actually."
    } ]
  }, {
    "tStartMs": 1663290,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "Like if you were to take those\npieces of the system prompt"
    } ]
  }, {
    "tStartMs": 1667820,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "and you were to show them to\nthe models as a system prompt,"
    } ]
  }, {
    "tStartMs": 1669680,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "you would actually get\nradically different behavior"
    } ]
  }, {
    "tStartMs": 1671510,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "than if you show it together."
    } ]
  }, {
    "tStartMs": 1672740,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Like a system prompt is a holistic thing."
    } ]
  }, {
    "tStartMs": 1674870,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "And if you were to show\nthe same system prompt"
    } ]
  }, {
    "tStartMs": 1676700,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "to a different model with\ndifferent dispositions,"
    } ]
  }, {
    "tStartMs": 1678890,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "you would also get different behavior."
    } ]
  }, {
    "tStartMs": 1680330,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "- [Stuart] It would\nact a differently, huh."
    } ]
  }, {
    "tStartMs": 1681310,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "- [Amanda] Yeah, so like\na lot of this stuff,"
    } ]
  }, {
    "tStartMs": 1682940,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "I think it's why, like, character training"
    } ]
  }, {
    "tStartMs": 1685880,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "and, you know, all of these things"
    } ]
  }, {
    "tStartMs": 1687500,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "are kind of, like, tricky\nbecause they're very hands-on"
    } ]
  }, {
    "tStartMs": 1690020,
    "dDurationMs": 1998,
    "segs": [ {
      "utf8": "and I think do require people to like,"
    } ]
  }, {
    "tStartMs": 1692018,
    "dDurationMs": 2322,
    "segs": [ {
      "utf8": "be, like, fine tuning the models"
    } ]
  }, {
    "tStartMs": 1694340,
    "dDurationMs": 1510,
    "segs": [ {
      "utf8": "and interacting with them a lot and like,"
    } ]
  }, {
    "tStartMs": 1695850,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "because they're very holistic."
    } ]
  }, {
    "tStartMs": 1697519,
    "dDurationMs": 4111,
    "segs": [ {
      "utf8": "They're much more like nudges, so yeah."
    } ]
  }, {
    "tStartMs": 1701630,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "- [Stuart] Okay, so\nthis isn't just a matter"
    } ]
  }, {
    "tStartMs": 1704720,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "of making the experience of\nusing Claude nicer for users,"
    } ]
  }, {
    "tStartMs": 1708170,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "although it might do\nthat into the bargain."
    } ]
  }, {
    "tStartMs": 1710720,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "This is an alignment question, right?"
    } ]
  }, {
    "tStartMs": 1712130,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "This is a question of\nhow do we align the model"
    } ]
  }, {
    "tStartMs": 1715700,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "with human values, values\nthat we want it to have?"
    } ]
  }, {
    "tStartMs": 1720892,
    "dDurationMs": 3808,
    "segs": [ {
      "utf8": "But the question immediately\nthen is, who decides?"
    } ]
  }, {
    "tStartMs": 1724700,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Who decides on what those values are?"
    } ]
  }, {
    "tStartMs": 1726890,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "- [Amanda] Yeah, and the\nanswer is it's me. (laughs)"
    } ]
  }, {
    "tStartMs": 1729530,
    "dDurationMs": 1692,
    "segs": [ {
      "utf8": "- [Stuart] Wow, okay."
    } ]
  }, {
    "tStartMs": 1731222,
    "dDurationMs": 2875,
    "segs": [ {
      "utf8": "- No, I think that like-\n- That's a scary thought."
    } ]
  }, {
    "tStartMs": 1734097,
    "dDurationMs": 1403,
    "segs": [ {
      "utf8": "- [Amanda] (laughs) How is that scary?"
