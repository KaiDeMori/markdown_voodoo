  }, {
    "tStartMs": 850200,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "That's the big five."
    } ]
  }, {
    "tStartMs": 851340,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Claude's got a lot more personality traits"
