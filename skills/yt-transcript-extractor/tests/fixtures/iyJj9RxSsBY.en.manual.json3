  }, {
    "tStartMs": 789728,
    "dDurationMs": 1942,
    "segs": [ {
      "utf8": "to elicit behavior from the model"
    } ]
  }, {
    "tStartMs": 791670,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "that is, like, kind of inconsistent"
