  }, {
    "tStartMs": 697740,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "or with the personality\nof Margaret Thatcher.\""
    } ]
  }, {
    "tStartMs": 701190,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Then, you know, it might start responding,"
    } ]
  }, {
    "tStartMs": 703500,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "you know, using sort of phrases\nthat she might have said,"
    } ]
  }, {
    "tStartMs": 706470,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "or it might start talking about freedom"
