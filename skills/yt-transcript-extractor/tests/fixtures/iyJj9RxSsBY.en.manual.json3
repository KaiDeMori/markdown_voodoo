  }, {
    "tStartMs": 583830,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "as this kind of, like, very objective,"
    } ]
  }, {
    "tStartMs": 586500,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "almost, like, robotic thing\nthat doesn't have, like, biases"
