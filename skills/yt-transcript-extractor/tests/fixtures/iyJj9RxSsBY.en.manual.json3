  }, {
    "tStartMs": 623580,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "If for example, it's been\ntrained to have, like, you know,"
    } ]
  }, {
    "tStartMs": 625590,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "slightly more, like, left-leaning,"
