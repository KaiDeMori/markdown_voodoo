  }, {
    "tStartMs": 845220,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Extroversion, conscientiousness,\nagreeableness,"
    } ]
  }, {
    "tStartMs": 847770,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "openness, neuroticism, there we go."
