  }, {
    "tStartMs": 864019,
    "dDurationMs": 3011,
    "segs": [ {
      "utf8": "versus the the psychologist or something."
    } ]
  }, {
    "tStartMs": 867030,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Because I guess I tend to think of this"
