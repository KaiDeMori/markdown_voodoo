  }, {
    "tStartMs": 726360,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "the actual personality\nthat's baked into the model?"
    } ]
  }, {
    "tStartMs": 729780,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "- [Amanda] Yeah, so when\nyou ask the model in context"
    } ]
  }, {
    "tStartMs": 733140,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "to play act, you know,\nyou're just kind of giving it"
    } ]
  }, {
    "tStartMs": 734880,
    "dDurationMs": 3556,
    "segs": [ {
      "utf8": "an instruction to act as if it, you know,"
    } ]
  }, {
    "tStartMs": 738436,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "has certain characteristics."
    } ]
  }, {
    "tStartMs": 740596,
    "dDurationMs": 2474,
    "segs": [ {
      "utf8": "With the character training,"
    } ]
  }, {
    "tStartMs": 743070,
    "dDurationMs": 2199,
    "segs": [ {
      "utf8": "the idea is that because\nthis is part of fine tuning,"
    } ]
  }, {
    "tStartMs": 745269,
    "dDurationMs": 3501,
    "segs": [ {
      "utf8": "you are, you know, say we have, like,"
