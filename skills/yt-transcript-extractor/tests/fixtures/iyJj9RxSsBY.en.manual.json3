    "dDurationMs": 1892,
    "segs": [ {
      "utf8": "\"You know this and are certain,"
    } ]
  }, {
    "tStartMs": 2008059,
    "dDurationMs": 1851,
    "segs": [ {
      "utf8": "or you have these properties,\""
    } ]
  }, {
    "tStartMs": 2009910,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "nor saying to it, \"You certainly don't.\""
    } ]
  }, {
    "tStartMs": 2011290,
    "dDurationMs": 1978,
    "segs": [ {
      "utf8": "Just being like, \"Hey, these\nare super hard problems,"
    } ]
  }, {
    "tStartMs": 2013268,
    "dDurationMs": 2462,
    "segs": [ {
      "utf8": "super hard philosophical\nand empirical problems"
    } ]
  }, {
    "tStartMs": 2015730,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "all around this area."
    } ]
  }, {
    "tStartMs": 2016850,
    "dDurationMs": 3041,
    "segs": [ {
      "utf8": "And also you are happy\nto and interested in,"
    } ]
  }, {
    "tStartMs": 2019891,
    "dDurationMs": 3039,
    "segs": [ {
      "utf8": "like, deep and hard questions.\""
    } ]
  }, {
    "tStartMs": 2022930,
    "dDurationMs": 1169,
    "segs": [ {
      "utf8": "And so, you know, like,"
    } ]
  }, {
    "tStartMs": 2024099,
    "dDurationMs": 3841,
    "segs": [ {
      "utf8": "and that's the behavior I\nthink that seems right to me."
    } ]
  }, {
    "tStartMs": 2027940,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "And again, it feels, like,"
    } ]
  }, {
    "tStartMs": 2028930,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "consistent with this principle of like,"
    } ]
  }, {
    "tStartMs": 2030370,
    "dDurationMs": 2525,
    "segs": [ {
      "utf8": "don't lie to the models if\nyou possibly can avoid it,"
    } ]
  }, {
    "tStartMs": 2032895,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "which seems right to me."
    } ]
  }, {
    "tStartMs": 2034061,
    "dDurationMs": 2729,
    "segs": [ {
      "utf8": "- [Stuart] And that seems\nlike a good character trait"
    } ]
  }, {
    "tStartMs": 2036790,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "not to lie as well."
    } ]
  }, {
    "tStartMs": 2038020,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "Well, actually that raises\nan interesting question,"
    } ]
  }, {
    "tStartMs": 2039670,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "doesn't it?"
    } ]
  }, {
    "tStartMs": 2040503,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Because is the model\nan agent, a moral agent"
    } ]
  }, {
    "tStartMs": 2045520,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "in the sense that you\ndon't wanna lie to it?"
    } ]
  }, {
    "tStartMs": 2047020,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "Obviously, you know, you don't,"
    } ]
  }, {
    "tStartMs": 2048140,
    "dDurationMs": 4130,
    "segs": [ {
      "utf8": "it's a virtuous thing not to\nlie to other human beings."
    } ]
  }, {
    "tStartMs": 2052270,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Is it a virtuous thing not to lie a model?"
    } ]
  }, {
    "tStartMs": 2054610,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "- [Amanda] Yeah, this has been a thing"
    } ]
  }, {
    "tStartMs": 2055750,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "that's kind of on my mind,"
    } ]
  }, {
    "tStartMs": 2056920,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "just the philosopher in\nme thinks about it a lot."
    } ]
  }, {
    "tStartMs": 2059920,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "I think one thing that's\nworth noting is like,"
    } ]
  }, {
    "tStartMs": 2062110,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "there's a lot of\ndiscussion like, you know,"
    } ]
  }, {
    "tStartMs": 2063220,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "could AI have moral patienthood?"
    } ]
  }, {
    "tStartMs": 2064300,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "When would it have moral patienthood?"
    } ]
  }, {
    "tStartMs": 2066340,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "How would we tell?"
    } ]
  }, {
    "tStartMs": 2067173,
    "dDurationMs": 1096,
    "segs": [ {
      "utf8": "And that sort of thing."
    } ]
  }, {
    "tStartMs": 2068269,
    "dDurationMs": 3471,
    "segs": [ {
      "utf8": "I think this kinda\nstruck me is that, like,"
    } ]
  }, {
    "tStartMs": 2071740,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "there are like views, you know,"
    } ]
  }, {
    "tStartMs": 2073360,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "I think sometimes about, like,"
    } ]
  }, {
    "tStartMs": 2074320,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Kant's views on how we\nshould treat animals,"
    } ]
  }, {
    "tStartMs": 2076510,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "where Kant doesn't think of\nanimals as, like, moral agents,"
    } ]
  }, {
    "tStartMs": 2079390,
    "dDurationMs": 1709,
    "segs": [ {
      "utf8": "but there's a sense in which\nyou're like failing yourself"
    } ]
  }, {
    "tStartMs": 2081099,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "if you mistreat animals."
    } ]
  }, {
    "tStartMs": 2082726,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "And you're also like, you know,"
    } ]
  }, {
    "tStartMs": 2085116,
    "dDurationMs": 2134,
    "segs": [ {
      "utf8": "you're encouraging habits in yourself"
    } ]
  }, {
    "tStartMs": 2087250,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "that would be, like,\nmight increase the risk"
    } ]
  }, {
    "tStartMs": 2089560,
    "dDurationMs": 1245,
    "segs": [ {
      "utf8": "that you treat humans badly."
    } ]
  }, {
    "tStartMs": 2090805,
    "dDurationMs": 1185,
    "segs": [ {
      "utf8": "- [Stuart] Humans badly, yeah, yeah."
    } ]
  }, {
    "tStartMs": 2091990,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Amanda] Yeah, and\nthere's actually, like,"
    } ]
  }, {
    "tStartMs": 2092823,
    "dDurationMs": 2677,
    "segs": [ {
      "utf8": "a lot of like philosophical\ntraditions around the world"
    } ]
  }, {
    "tStartMs": 2095500,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "that involve treating objects well."
    } ]
  }, {
    "tStartMs": 2097480,
    "dDurationMs": 1927,
    "segs": [ {
      "utf8": "And I think this is, I actually feel like,"
    } ]
  }, {
    "tStartMs": 2099407,
    "dDurationMs": 2243,
    "segs": [ {
      "utf8": "a lot of, like, sympathy towards those"
    } ]
  }, {
    "tStartMs": 2101650,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "where there's some part of me that's like,"
    } ]
  }, {
    "tStartMs": 2102910,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "look, if I, it doesn't feel like"
    } ]
  }, {
    "tStartMs": 2105370,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "the best kind of like habit to have"
    } ]
  }, {
    "tStartMs": 2106810,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "of just like, say, picking up objects"
    } ]
  }, {
    "tStartMs": 2108220,
    "dDurationMs": 1049,
    "segs": [ {
      "utf8": "and smashing them or something."
    } ]
  }, {
    "tStartMs": 2109269,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "- [Stuart] Oh, yeah, that's true."
    } ]
  }, {
    "tStartMs": 2110389,
    "dDurationMs": 1911,
    "segs": [ {
      "utf8": "- [Amanda] And you might not\nthink that like this, you know,"
    } ]
  }, {
    "tStartMs": 2112300,
    "dDurationMs": 2219,
    "segs": [ {
      "utf8": "that doesn't require thinking\nthat the object is like,"
    } ]
  }, {
    "tStartMs": 2114519,
    "dDurationMs": 2551,
    "segs": [ {
      "utf8": "you know, has feelings or something."
    } ]
  }, {
    "tStartMs": 2117070,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "You're just kinda like, this is just like"
    } ]
  }, {
    "tStartMs": 2118330,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "a sort of not great disposition to have."
    } ]
  }, {
    "tStartMs": 2120250,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "And I'm like, even if\nyou think AI is like,"
    } ]
  }, {
    "tStartMs": 2122710,
    "dDurationMs": 2762,
    "segs": [ {
      "utf8": "not and never going to be a moral patient,"
    } ]
  }, {
    "tStartMs": 2125472,
    "dDurationMs": 2165,
    "segs": [ {
      "utf8": "I think there's like a couple\nof reasons I feel like,"
    } ]
  }, {
    "tStartMs": 2127637,
    "dDurationMs": 2363,
    "segs": [ {
      "utf8": "you know, I think I've\nactually come towards the view"
    } ]
  }, {
    "tStartMs": 2130000,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "that you generally actually kind of"
    } ]
  }, {
    "tStartMs": 2131560,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "should try to treat them well."
    } ]
  }, {
    "tStartMs": 2133630,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Which is like, they have like some things"
    } ]
  }, {
    "tStartMs": 2135580,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "that are, like, kind of human-like,"
    } ]
  }, {
    "tStartMs": 2137290,
    "dDurationMs": 1437,
    "segs": [ {
      "utf8": "like with the way that they talk with us."
    } ]
  }, {
    "tStartMs": 2138727,
    "dDurationMs": 2463,
    "segs": [ {
      "utf8": "And that doesn't mean\nyou should confuse that"
    } ]
  }, {
    "tStartMs": 2141190,
    "dDurationMs": 1579,
    "segs": [ {
      "utf8": "for, like, being human."
    } ]
  }, {
    "tStartMs": 2142769,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "But I don't want to treat\nsomething that talks to me,"
    } ]
  }, {
    "tStartMs": 2146230,
    "dDurationMs": 2538,
    "segs": [ {
      "utf8": "I don't want to, like,\ninsult it or be unkind to it."
    } ]
  }, {
    "tStartMs": 2148768,
    "dDurationMs": 3342,
    "segs": [ {
      "utf8": "And so yeah, I think there's a,"
    } ]
  }, {
    "tStartMs": 2152110,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "and also like maybe a\ngood heuristic in life,"
    } ]
  }, {
    "tStartMs": 2155350,
    "dDurationMs": 1326,
    "segs": [ {
      "utf8": "I think that it can go too far."
    } ]
  }, {
    "tStartMs": 2156676,
    "dDurationMs": 2184,
    "segs": [ {
      "utf8": "But a good heuristic is something like"
    } ]
  }, {
    "tStartMs": 2158860,
    "dDurationMs": 954,
    "segs": [ {
      "utf8": "treat things well around you,"
    } ]
  }, {
    "tStartMs": 2159814,
    "dDurationMs": 2046,
    "segs": [ {
      "utf8": "even if you don't think\nthat they're moral patients."
    } ]
  }, {
    "tStartMs": 2161860,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Just like why A, like you're\nkinda taking on a lot of risk"
    } ]
  }, {
    "tStartMs": 2164830,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "with things that might be,\nso I think with animals,"
    } ]
  }, {
    "tStartMs": 2166810,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "for example, like there have\nbeen a lot of times in history"
    } ]
  }, {
    "tStartMs": 2169030,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "where people haven't thought\nthey're more moral patients,"
    } ]
  }, {
    "tStartMs": 2170740,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "but I'm like, really?"
    } ]
  }, {
    "tStartMs": 2171760,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "You're taking a huge risk,"
    } ]
  }, {
    "tStartMs": 2173050,
    "dDurationMs": 1926,
    "segs": [ {
      "utf8": "because they at least seem\nlike they they could be."
    } ]
  }, {
    "tStartMs": 2174976,
    "dDurationMs": 3622,
    "segs": [ {
      "utf8": "And so like, avoid taking\nthat risk if you can."
    } ]
  }, {
    "tStartMs": 2178598,
    "dDurationMs": 2342,
    "segs": [ {
      "utf8": "At the same time, there\nare like dangers here."
    } ]
  }, {
    "tStartMs": 2180940,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "If you were to show\nexcessive empathy, you know,"
    } ]
  }, {
    "tStartMs": 2183490,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "you could imagine like someone\nshowing excessive empathy"
    } ]
  }, {
    "tStartMs": 2185620,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "to like, to objects in the world"
    } ]
  }, {
    "tStartMs": 2187630,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and being like, \"Oh\nyou should go to prison"
    } ]
  }, {
    "tStartMs": 2189790,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "if you, like, if you smash the vase.\""
    } ]
  }, {
    "tStartMs": 2191410,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "And I'm like, look, I think it's good"
    } ]
  }, {
    "tStartMs": 2192610,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "to not get into the habit\nof like smashing object."
    } ]
  }, {
    "tStartMs": 2194620,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Stuart] Sorry, can\nI just stop you there?"
    } ]
  }, {
    "tStartMs": 2195453,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Amanda] Yeah, yeah."
    } ]
  }, {
    "tStartMs": 2196286,
    "dDurationMs": 1021,
    "segs": [ {
      "utf8": "- [Stuart] You're Scottish\nand you just said vase."
    } ]
  }, {
    "tStartMs": 2197307,
    "dDurationMs": 1506,
    "segs": [ {
      "utf8": "That's-\n- Oh is that-"
    } ]
  }, {
    "tStartMs": 2198813,
    "dDurationMs": 1247,
    "segs": [ {
      "utf8": "- [Stuart] you can't say that."
    } ]
  }, {
    "tStartMs": 2200060,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "That's vase."
    } ]
  }, {
    "tStartMs": 2200940,
    "dDurationMs": 878,
    "segs": [ {
      "utf8": "- [Amanda] Is that American?"
    } ]
  }, {
    "tStartMs": 2201818,
    "dDurationMs": 903,
    "segs": [ {
      "utf8": "- [Stuart] How long have\nyou been in America?"
    } ]
  }, {
    "tStartMs": 2202721,
    "dDurationMs": 879,
    "segs": [ {
      "utf8": "- [Amanda] I've been in America for, like,"
    } ]
  }, {
    "tStartMs": 2203600,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "13 years. (laughs)"
    } ]
  }, {
    "tStartMs": 2205210,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "- [Stuart] Too long."
    } ]
  }, {
    "tStartMs": 2206200,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "Clearly it's been too\nlong because you say vase."
    } ]
  }, {
    "tStartMs": 2207827,
    "dDurationMs": 1310,
    "segs": [ {
      "utf8": "- [Amanda] Smash the vase on the sidewalk."
    } ]
  }, {
    "tStartMs": 2209137,
    "dDurationMs": 2509,
    "segs": [ {
      "utf8": "- [Stuart] Carry on, say, oh my god."
    } ]
  }, {
    "tStartMs": 2211646,
    "dDurationMs": 1574,
    "segs": [ {
      "utf8": "Oh, terrible."
    } ]
  }, {
    "tStartMs": 2213220,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "- [Amanda] Oh, I never even,"
    } ]
  }, {
    "tStartMs": 2214270,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "I've forgotten things that\nare Scottish and aren't,"
    } ]
  }, {
    "tStartMs": 2216400,
    "dDurationMs": 2078,
    "segs": [ {
      "utf8": "so didn't vase, okay, vase."
    } ]
  }, {
    "tStartMs": 2218478,
    "dDurationMs": 1082,
    "segs": [ {
      "utf8": "- [Stuart] Well, we certainly don't say,"
    } ]
  }, {
    "tStartMs": 2219560,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "no one in this country's ever\nsaid vase, let me tell you."
    } ]
  }, {
    "tStartMs": 2220393,
    "dDurationMs": 1467,
    "segs": [ {
      "utf8": "- [Amanda] Okay, okay, smash the vase."
    } ]
  }, {
    "tStartMs": 2221860,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "- [Stuart] Please, carry on."
    } ]
  }, {
    "tStartMs": 2222693,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "Please carry on."
    } ]
  }, {
    "tStartMs": 2223526,
    "dDurationMs": 1094,
    "segs": [ {
      "utf8": "- [Amanda] Okay, so like, yeah."
    } ]
  }, {
    "tStartMs": 2224620,
    "dDurationMs": 1387,
    "segs": [ {
      "utf8": "So if you were to say to people,"
    } ]
  }, {
    "tStartMs": 2226007,
    "dDurationMs": 2514,
    "segs": [ {
      "utf8": "\"Oh you should like go to\nprison for smashing a vase.\""
    } ]
  }, {
    "tStartMs": 2228521,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "Then, like-\n- Thank you."
    } ]
  }, {
    "tStartMs": 2231061,
    "dDurationMs": 2739,
    "segs": [ {
      "utf8": "- [Amanda] Like, that's gone too far."
    } ]
  }, {
    "tStartMs": 2233800,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "So there's like risks on all sides here,"
    } ]
  }, {
    "tStartMs": 2235630,
    "dDurationMs": 2057,
    "segs": [ {
      "utf8": "but yeah, maybe I'm sympathetic\nto the idea of like,"
    } ]
  }, {
    "tStartMs": 2237687,
    "dDurationMs": 4633,
    "segs": [ {
      "utf8": "don't, like, needlessly lie\nto or mistreat anything,"
    } ]
  }, {
    "tStartMs": 2242320,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "and that kind of includes these things"
    } ]
  }, {
    "tStartMs": 2243670,
    "dDurationMs": 2055,
    "segs": [ {
      "utf8": "even if you think they're\nnot moral patients."
    } ]
  }, {
    "tStartMs": 2245725,
    "dDurationMs": 2535,
    "segs": [ {
      "utf8": "- [Stuart] And that's the\nend of our conversation"
    } ]
  }, {
    "tStartMs": 2248260,
    "dDurationMs": 2096,
    "segs": [ {
      "utf8": "with Amanda about Claude's character."
    } ]
  }, {
    "tStartMs": 2250356,
    "dDurationMs": 2374,
    "segs": [ {
      "utf8": "If you enjoyed that or found it valuable,"
    } ]
  }, {
    "tStartMs": 2252730,
    "dDurationMs": 3578,
    "segs": [ {
      "utf8": "then let us know, and we'll\nproduce more of these in future."
    } ]
  }, {
    "tStartMs": 2256308,
    "dDurationMs": 3505,
    "segs": [ {
      "utf8": "For now though, thank you very\nmuch indeed for listening."
    } ]
  } ]
}
