    "dDurationMs": 4209,
    "segs": [ {
      "utf8": "move the model, and in the\ncase of Claude, you know,"
    } ]
  }, {
    "tStartMs": 561477,
    "dDurationMs": 2163,
    "segs": [ {
      "utf8": "I think that there's this concern"
    } ]
  }, {
    "tStartMs": 563640,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "that I actually have that, like, you know,"
    } ]
  }, {
    "tStartMs": 565350,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "there's one concern which is"
    } ]
  }, {
    "tStartMs": 566460,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "people over-anthropomorphizing AI,"
    } ]
  }, {
    "tStartMs": 568800,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "which I think is, like, a real concern."
    } ]
  }, {
    "tStartMs": 570330,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "You want people to be completely aware of"
    } ]
  }, {
    "tStartMs": 572070,
    "dDurationMs": 1946,
    "segs": [ {
      "utf8": "exactly what they're interacting with"
    } ]
  }, {
    "tStartMs": 574016,
    "dDurationMs": 2709,
    "segs": [ {
      "utf8": "and to kind of be under no illusions."
    } ]
  }, {
    "tStartMs": 576725,
    "dDurationMs": 1581,
    "segs": [ {
      "utf8": "I feel like that's really important."
    } ]
  }, {
    "tStartMs": 578306,
    "dDurationMs": 3124,
    "segs": [ {
      "utf8": "At the same time, I\nthink I'm a bit worried"
